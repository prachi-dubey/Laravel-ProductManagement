#!/usr/bin/env bash
# Start Laravel with XAMPP PHP 8.2 (PHPRC-safe). Global php stays 7.4.
DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$DIR/use-php82.sh"
HOST="${1:-127.0.0.1}"
PORT="${2:-8000}"
cd "$DIR/.."
exec php artisan serve --host="$HOST" --port="$PORT" --no-reload
