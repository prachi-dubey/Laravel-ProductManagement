#!/usr/bin/env bash
# Always run artisan with XAMPP PHP 8.2 (global php stays 7.4).
DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
export PHPRC="$ROOT/.php"
export PATH="$DIR:$PATH"
cd "$ROOT"

# `artisan serve` spawns a child PHP process. Ensure our PHPRC ini is used
# (see AppServiceProvider ServeCommand passthrough + --no-reload fallback).
if [[ "${1:-}" == "serve" ]]; then
  shift
  has_no_reload=0
  for arg in "$@"; do
    if [[ "$arg" == "--no-reload" ]]; then
      has_no_reload=1
      break
    fi
  done
  if [[ $has_no_reload -eq 0 ]]; then
    exec php artisan serve --no-reload "$@"
  fi
  exec php artisan serve "$@"
fi

exec php artisan "$@"
